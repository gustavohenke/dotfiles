[user]
  name = {{ .name }}
  email = {{ .email }}

[core]
  editor = {{ if eq .chezmoi.os "darwin" }}open -W -n{{ else }}nano{{ end }}

[log]
  abbrevCommit = true
  decorate = true

[format]
  pretty = oneline

[alias]
  l = log --graph --color
  fp = fetch --prune
  cp = cherry-pick
  # Shows diff stats between HEAD and another branch
  diffbase = "!f() { git diff --stat \"$(git merge-base HEAD \"$1\")\" HEAD; }; f"
  # Checks out a remote branch that's not available locally
	checkout-remote = "!f() { git fetch origin \"$1:refs/remotes/origin/$1\" && git checkout -b \"$1\" --no-track \"refs/remotes/origin/$1\"; }; f"
  # Fetches a branch and force resets local state to match it (discards local changes)
  # Intentionally named `sync-remote` to be the counterpart to `checkout-remote` above.
	sync-remote = "!f() { git fetch origin \"$1\" && git reset --hard FETCH_HEAD; }; f"

[diff "plist"]
  textconv = plutil -convert xml1 -o -

[filter "lfs"]
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f

[protocol]
  version = 2

[pull]
  ff = only

[init]
  defaultBranch = main

[push]
  autoSetupRemote = true

{{ if eq .profile "work-laptop" -}}
{{/* Canvaboy is a desktop tool, so not meaningful in a devbox that's accessed via SSH */}}
[canvaboy]
  githubToken = {{ onepasswordRead "op://dotfiles/GitHub Token - Canvaboy/token" "my" }}
{{- end -}}
